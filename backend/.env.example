# Demo local Android. No necesita clave de Gemini.
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_EXPERIMENTAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60
DATABASE_URL=sqlite:///./data/asesor_ia.db
REDIS_URL=
MAX_UPLOAD_MB=8
IMAGE_MAX_SIDE=1024
# Genera una clave privada, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# En producción SECRET_KEY debe ser explícita y tener al menos 32 caracteres.
# CORS_ORIGINS usa JSON, por ejemplo: ["https://tu-web.example"]
