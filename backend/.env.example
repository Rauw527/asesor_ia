# ---------------------------------------------------------------------------
# Asesor IA - backend environment
# Copy to `.env` (same folder as requirements.txt) and fill GEMINI_API_KEY.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required for every AI endpoint. Without it the API answers HTTP 503.



# Gemini 1.5 Flash was retired by Google; `gemini-flash-latest` points to the
# current stable Flash model. Pin an exact version if you need reproducibility.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60

# Default: zero-infrastructure SQLite.
# PostgreSQL + pgvector:
#   DATABASE_URL=postgresql+psycopg://asesor:asesor@localhost:5432/asesor_ia
DATABASE_URL=sqlite:///./data/asesor_ia.db

# Optional: Redis for the INCI cache. Falls back to in-process TTL cache.
REDIS_URL=
INCI_CACHE_TTL_SECONDS=86400

# Affiliate links are generated from this template (never by the model).
AFFILIATE_SEARCH_TEMPLATE=https://www.amazon.com/s?k={query}
AFFILIATE_TAG=

# Demo identity used while Phase 1 has no authentication.
DEMO_USER_EMAIL=demo@asesor.ia
DEMO_USER_NAME=Demo User

# Upload limits
MAX_UPLOAD_MB=8
IMAGE_MAX_SIDE=1024
